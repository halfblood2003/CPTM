# Copy to .env and set a long random token before starting.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
CPTM_TOKEN=

# ---------------------------------------------------------------------------
# Cloud credentials are read by the tool containers from these variables.
# They are also honoured by `docker compose` when set here, so you can keep one
# file for both the app and the scanners. Nothing here is committed: .env is
# gitignored.
# ---------------------------------------------------------------------------

# --- AWS (used by Prowler/ScoutSuite/Pacu/CloudFox/PMapper) -----------------
# Preferred: put a shared credentials file at credentials/aws/credentials
#   [default]
#   aws_access_key_id = ...
#   aws_secret_access_key = ...
# and a region profile at credentials/aws/config. Those paths are already wired
# into the toolbox container. Alternatively, export keys here:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_DEFAULT_REGION=us-east-1

# --- Azure (used by Prowler/ScoutSuite/ROADrecon/MicroBurst) ----------------
# Service principal env vars for `prowler azure --sp-env-auth`:
# AZURE_CLIENT_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
# Or place an azure-cli credentials file under credentials/azure and use
# `az login` inside the web Terminal.

# --- GCP (used by Prowler/ScoutSuite/GCP Scanner) --------------------------
# Drop a service-account JSON key at credentials/gcp/sa.json - the container
# already points GOOGLE_APPLICATION_CREDENTIALS at it.
